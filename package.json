{
  "name": "warden-action",
  "version": "1.0.0",
  "description": "GitHub Action and CLI for Yuanxi repository security and license scans",
  "private": true,
  "main": "dist/index.js",
  "bin": {
    "warden": "src/cli.js"
  },
  "scripts": {
    "build": "ncc build src/action.js -o dist --minify --source-map",
    "check": "npm run test && npm run build",
    "test": "node --test",
    "warden": "node src/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.45.0"
  },
  "license": "MIT"
}