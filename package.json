{
  "name": "warden-action",
  "version": "1.0.0",
  "description": "GitHub Action and CLI for Yuanxi repository security and license scans",
  "private": true,
  "main": "dist/index.js",
  "bin": {
    "warden": "dist/cli/index.js"
  },
  "scripts": {
    "build": "pnpm build:action && pnpm build:cli",
    "build:action": "ncc build src/action.ts -o dist --minify --source-map --no-cache",
    "build:cli": "ncc build src/cli.ts -o dist/cli --minify --source-map --no-cache",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "warden": "tsx src/cli.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vercel/ncc": "^0.45.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "license": "MIT"
}